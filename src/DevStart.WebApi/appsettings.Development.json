{
  "ConnectionStrings": {
    "Database": "Host=main-db;Port=5432;Database=devstart;Username=postgres;Password=postgres"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "devstart",
    "Audience": "developers",
    "ExpirationInMinutes": 60,
    "RefreshToken": {
      "LifetimeDays": 30
    }
  },
  "OAuth": {
    "Google": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:5000/api/auth/oauth/google/callback",
      "Scopes": [ "openid", "email", "profile" ]
    },
    "GitHub": {
      "ClientId": "",
      "ClientSecret": "",
      "RedirectUri": "http://localhost:5000/api/auth/oauth/github/callback",
      "Scopes": [ "read:user", "user:email" ]
    }
  },
  "Minio": {
    "Endpoint": "minio:9000",
    "AccessKey": "minioadmin",
    "SecretKey": "minioadminpassword",
    "Bucket": "files",
    "UseSsl": false,
    "PubEndpoint": "localhost:8080",
    "PubUseSsl": false
  },
  "Redis": {
    "ConnectionString": "redis:6379,user=redis,password=redis,abortConnect=false",
    "InstanceName": "app"
  },
  "Smtp": {
    "Host": "mailpit",
    "Port": 1025,
    "EnableSsl": false,
    "UseDefaultCredentials": false,
    "Username": "vovan990028@gmail.com",
    "Password": ""
  },
  "Centrifugo": {
    "ApiUrl": "http://centrifugo:8000",
    "ApiKey": "centrifugo-internal-api-key",
    "TokenHmacSecret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "TokenExpirationInMinutes": 10
  }
}