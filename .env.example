# DevStart environment variables — copy to `.env` and fill in
#   cp .env.example .env
# Generate a secret:  openssl rand -base64 48
# Used by docker-compose.yml (local dev)

REDIS_PASSWORD=my_redis_password
REDIS_USER=my_user
REDIS_USER_PASSWORD=my_user_password


# Used by docker-compose.prod.yml (production) — required

ASPNETCORE_ENVIRONMENT=Production

# Postgres
POSTGRES_DB=devstart
POSTGRES_USER=devstart
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# MinIO / S3 object storage
MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME_strong_minio_password
MINIO_BUCKET=files
# UseSsl is for the INTERNAL client (app -> minio:9000), which is plaintext — keep false
MINIO_USE_SSL=false
# PubEndpoint = the API host; PubUseSsl=true makes presigned URLs https
MINIO_PUB_ENDPOINT=example.com
MINIO_PUB_USE_SSL=true

# JWT secret MUST be at least 32 characters (256 bits) for HS256
JWT_SECRET=CHANGE_ME_at_least_32_characters_long
JWT_ISSUER=devstart
JWT_AUDIENCE=developers
JWT_EXPIRATION_MINUTES=60

# 2FA: AES-256 key encrypting TOTP secrets at rest — MUST be base64 of exactly 32 bytes
# (openssl rand -base64 32). Losing it bricks 2FA for every enrolled user — back it up.
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_base64_32_bytes

# "Remember this device": ceiling on how long a browser may skip the 2FA code. The user
# picks a preset (7/14/30/60/90) and the effective duration is min(choice, ceiling).
# All optional — the defaults below are what the app uses when these are unset.
# Set TRUSTED_DEVICES_ENABLED=false to switch the feature off platform-wide.
TRUSTED_DEVICES_ENABLED=true
TRUSTED_DEVICE_MAX_DAYS=30
TRUSTED_DEVICE_ADMIN_MAX_DAYS=7

# OAuth (configure the apps in Google / GitHub consoles)
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=https://example.com/api/auth/oauth/google/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=https://example.com/api/auth/oauth/github/callback

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=

# Centrifugo (real-time)
CENTRIFUGO_API_KEY=CHANGE_ME
CENTRIFUGO_TOKEN_HMAC_SECRET=CHANGE_ME_at_least_32_characters_long
CENTRIFUGO_ADMIN_PASSWORD=CHANGE_ME
CENTRIFUGO_ADMIN_SECRET=CHANGE_ME

# YooKassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://example.com/billing/return

# Frontend SPA base URL — used to redirect email-verification links to a friendly page.
# Leave empty only if the SPA is served same-origin as the API (then a relative redirect is used).
FRONTEND_BASE_URL=https://example.com

# nginx + TLS (certbot). DOMAIN is substituted into config/nginx/nginx.prod.conf.template
# (server_name + certificate paths) when the nginx container starts.
# Used by init-letsencrypt.sh for the initial certificate issuance.
DOMAIN=example.com
LETSENCRYPT_EMAIL=admin@example.com

# Reverse proxy: the network/IP the app trusts X-Forwarded-* from.
# Set to the docker subnet of this stack (find it with:
#   docker network inspect <project>_devstart-net -f '{{ (index .IPAM.Config 0).Subnet }}')
FORWARDED_KNOWN_NETWORKS=172.16.0.0/12

# Observability
# Grafana admin password (login at the internal Grafana; reach it via SSH tunnel or an auth'd route).
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_strong_grafana_password
# Shared secret the Hangfire dashboard trusts from nginx. Substituted into the "X-Hangfire-Auth"
# header in config/nginx/nginx.prod.conf.template and passed to the API as
# Hangfire__Dashboard__ProxyAuthSecret — both sides read this one value, so they always match.
# Create the Basic Auth users file too:  htpasswd -c ./config/nginx/.htpasswd <admin-user>
HANGFIRE_DASHBOARD_SECRET=CHANGE_ME_at_least_32_characters_long

# Matomo (self-hosted analytics, served at https://<DOMAIN>/matomo/ — no subdomain, no extra cert)
# Matomo supports MySQL/MariaDB only and has NO PostgreSQL driver, so it runs its own `matomo-db`
# container; the existing Postgres `main-db` cannot be reused.
MATOMO_DB_NAME=matomo
MATOMO_DB_USER=matomo
MATOMO_DB_PASSWORD=CHANGE_ME_strong_matomo_db_password
MATOMO_DB_ROOT_PASSWORD=CHANGE_ME_strong_matomo_root_password
# Site id created by the install wizard — the first site is always 1. This is BAKED INTO the SPA
# bundle at build time (docker-compose.prod.yml -> frontend build arg MATOMO_SITE_ID), so after
# changing it run:  docker compose -f docker-compose.prod.yml up -d --build frontend
MATOMO_SITE_ID=1
# PHP memory limit for the Matomo UI and the archiving sidecar. 512M is Matomo's recommendation
# for `console core:archive`; drop to 256M on a 4 GB VPS and raise it only if archiving reports
# memory exhaustion.
MATOMO_PHP_MEMORY_LIMIT=512M
# How often the matomo-archive sidecar runs `console core:archive` (browser-triggered archiving
# is disabled in config/matomo/common.config.prod.ini.php). Any `sleep` argument: 1h, 6h, 3600.
# Start at 6h — a low-traffic site gains nothing from hourly archiving, and the run briefly
# allocates up to MATOMO_PHP_MEMORY_LIMIT.
MATOMO_ARCHIVE_INTERVAL=6h
# NOTE: the Matomo superuser login/password are deliberately NOT here. They are set once in the
# web install wizard (DEPLOYMENT.md) and belong in your password manager, never in the repo.
